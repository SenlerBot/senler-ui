{
  "name": "@senler/ui",
  "version": "0.5.29",
  "private": false,
  "type": "module",
  "description": "Senler React 19 UI component library with shared styles, atoms, layout primitives, forms, and overlays",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SenlerBot/senler-ui.git"
  },
  "bugs": {
    "url": "https://github.com/SenlerBot/senler-ui/issues"
  },
  "homepage": "https://ui.senler.io",
  "engines": {
    "node": ">=24 <25"
  },
  "sideEffects": [
    "./dist/browser-compat.js",
    "./dist/fonts.css",
    "./dist/styles.css",
    "./dist/tailwind.css",
    "./dist/tokens.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js",
      "default": "./dist/code.js"
    },
    "./app-shell": {
      "types": "./dist/app-shell.d.ts",
      "import": "./dist/app-shell.js",
      "default": "./dist/app-shell.js"
    },
    "./browser-compat": {
      "types": "./dist/browser-compat.d.ts",
      "import": "./dist/browser-compat.js",
      "default": "./dist/browser-compat.js"
    },
    "./browser-support": {
      "types": "./dist/browser-support.d.ts",
      "import": "./dist/browser-support.js",
      "default": "./dist/browser-support.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./vite-browser-compat": {
      "types": "./dist/vite-browser-compat.d.ts",
      "import": "./dist/vite-browser-compat.js",
      "default": "./dist/vite-browser-compat.js"
    },
    "./vite-css-compat": {
      "types": "./dist/vite-css-compat.d.ts",
      "import": "./dist/vite-css-compat.js",
      "default": "./dist/vite-css-compat.js"
    },
    "./vite-app-version": {
      "types": "./dist/vite-app-version.d.ts",
      "import": "./dist/vite-app-version.js",
      "default": "./dist/vite-app-version.js"
    },
    "./frontend-release": {
      "types": "./dist/frontend-release.d.ts",
      "import": "./dist/frontend-release.js",
      "default": "./dist/frontend-release.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.css": "./dist/tokens.css",
    "./atoms/*": {
      "types": "./dist/atoms/*.d.ts",
      "import": "./dist/atoms/*.js",
      "default": "./dist/atoms/*.js"
    },
    "./compound/*": {
      "types": "./dist/compound/*.d.ts",
      "import": "./dist/compound/*.js",
      "default": "./dist/compound/*.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*.d.ts",
      "import": "./dist/layout/*.js",
      "default": "./dist/layout/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "sh scripts/development/run-heavy-task.sh --repo senler-ui --task build -- npm run build:internal",
    "build:internal": "npm run check:full:internal && npm run build:artifact:internal && npm run test:dist",
    "build:artifact": "sh scripts/development/run-heavy-task.sh --repo senler-ui --task build-artifact -- npm run build:artifact:internal",
    "build:artifact:internal": "npm run clean && vite build && npm run copy:css && tsc -p tsconfig.build.json && npm run package:state:write && npm run normalize:dist",
    "copy:css": "node scripts/copy-css.mjs",
    "normalize:dist": "chmod -R a+rX dist",
    "test": "npm run test:source",
    "test:source": "node scripts/test-css-compat.mjs --source && node scripts/test-tabs.mjs --source",
    "test:dist": "node scripts/test-css-compat.mjs --dist && node scripts/test-tabs.mjs --dist && node scripts/test-package.mjs && node scripts/test-bridge.mjs && node scripts/test-frontend-release.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsconfig.type-check.tsbuildinfo",
    "type-check:configs": "tsc -p tsconfig.configs.json --noEmit",
    "package:state:write": "node scripts/package-state.mjs --write",
    "package:state:check": "node scripts/package-state.mjs --check",
    "check:fast": "sh scripts/development/run-heavy-task.sh --repo senler-ui --task check-fast -- npm run check:fast:internal",
    "check:fast:internal": "node scripts/development/run-npm-sequence.mjs type-check type-check:configs",
    "check:full": "sh scripts/development/run-heavy-task.sh --repo senler-ui --task check-full -- npm run check:full:internal",
    "check:full:internal": "npm run check:fast && npm run test:source",
    "prepack": "npm run package:state:check"
  },
  "peerDependencies": {
    "lightningcss": ">=1.31.0 <2",
    "lucide-react": "^0.555.0 || ^0.575.0 || ^0.577.0 || ^1.7.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "prism-react-renderer": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-announce": "^0.2.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "browserslist": "^4.28.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.14.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "lightningcss": "^1.33.0",
    "lucide-react": "1.31.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
